# Supabase 프로젝트 설정 → API Settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# 서버 전용 값입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# ADMIN_PASSWORD_HASH를 권장합니다. bcrypt cost 12 해시를 서버 Secret으로 등록하세요.
ADMIN_PASSWORD_HASH=SET_A_BCRYPT_HASH
# 기존 배포 호환용이며 ADMIN_PASSWORD_HASH 설정 후 제거할 수 있습니다.
ADMIN_PASSWORD=SET_A_PRIVATE_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# 카카오 알림톡 공급사 어댑터 설정 (모두 서버 Secret/Config)
KAKAO_ALIMTALK_API_URL=https://YOUR_PROVIDER_ADAPTER/alimtalk/send
KAKAO_ALIMTALK_API_KEY=YOUR_PROVIDER_API_KEY
KAKAO_ALIMTALK_SENDER_KEY=YOUR_KAKAO_CHANNEL_SENDER_KEY
KAKAO_ALIMTALK_MATCH_TEMPLATE_CODE=BLUEPEACE_MATCH_REQUESTED
KAKAO_ALIMTALK_APPROVAL_TEMPLATE_CODE=BLUEPEACE_INSTRUCTOR_APPROVED
KAKAO_ADMIN_PHONE=01000000000

